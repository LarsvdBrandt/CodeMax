# ── CodeMax Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Changes to .env take effect on the next `docker compose up` (no rebuild needed).
# Changes to application.yml require `docker compose up --build backend`.

# ── Auth ────────────────────────────────────────────────────────────────────
# JWT_SECRET is shared between Better Auth (Next.js) and Spring Boot for token validation.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Better Auth email provider — used for verification emails and password resets.
RESEND_API_KEY=re_...

# Better Auth app URL — used to build links in emails. Set to your public URL in production.
# BETTER_AUTH_URL=http://localhost:3000

# ── AI Provider Keys ────────────────────────────────────────────────────────
# Set the key for whichever providers you want to use.
# You only need one; leave the others blank.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ── AI Model Selection ──────────────────────────────────────────────────────
# Which model to use for each stage of the pipeline.
# Defaults (used when these vars are absent) are set in application.yml.
#
# OpenAI models:    gpt-4o  gpt-4.1  gpt-5  gpt-5-mini
# Anthropic models: claude-sonnet-4-5  claude-opus-4-5
# Gemini models:    gemini-2.5-pro  gemini-2.5-flash
# DeepSeek models:  deepseek-chat  deepseek-reasoner
#
# The provider is detected automatically from the model name — no extra config needed.

PLANNER_MODEL=gpt-4o
CODE_MODEL=gpt-4o
REVIEW_MODEL=gpt-4o

# ── Frontend ─────────────────────────────────────────────────────────────────
# Shown in the CodeMax UI
NEXT_PUBLIC_APP_NAME=CodeMax

# ── Infrastructure (usually set by docker-compose.yml — override here if needed) ──
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/codemax
# SPRING_DATASOURCE_USERNAME=codemax
# SPRING_DATASOURCE_PASSWORD=codemax
# SPRING_RABBITMQ_HOST=rabbitmq
# MONGO_ROOT_URL=mongodb://codemax:codemax@mongodb:27017
# PROJECTS_DIR=/projects
# TEMPLATES_DIR=/templates
# CORS_ALLOW_ORIGINS=http://localhost:3000
# SERVER_PORT=8000

# (RESEND_API_KEY is listed above in the Auth section)