# ═════════════════════════════════════════════════════════════════════════════
# FRONTEND + DOCKER ENVIRONMENT VARIABLES
# Copy to .env — never commit .env
#
# Variable naming convention:
#   VITE_*             → exposed to the browser (build-time injection by Vite)
#   *_PORT             → host port (what your laptop connects to)
#   *_INTERNAL_PORT    → container-internal port (what the process binds to)
#   COMPOSE_*          → docker-compose behaviour
# ═════════════════════════════════════════════════════════════════════════════

# ── App identity ──────────────────────────────────────────────────────────────
# Shown in <title>, Navbar brand, and email templates.
APP_NAME=AppTemplate

# ── Docker project name ───────────────────────────────────────────────────────
# Used as a prefix for all container and volume names.
# CHANGE THIS when running multiple stacks to avoid conflicts.
COMPOSE_PROJECT_NAME=apptemplate

# ── Service: Frontend (Vite) ──────────────────────────────────────────────────
FRONTEND_PORT=5173          # host port — open http://localhost:5173
FRONTEND_INTERNAL_PORT=5173 # port Vite binds to inside the container

# ── Service: Backend (Express) ────────────────────────────────────────────────
BACKEND_PORT=3000           # host port — API at http://localhost:3000
BACKEND_INTERNAL_PORT=3000  # port Express binds to inside the container

# ── Service: MongoDB ──────────────────────────────────────────────────────────
MONGO_PORT=27017            # host port — mongo accessible at localhost:27017
MONGO_INTERNAL_PORT=27017   # port mongod binds to inside the container
MONGO_DB_NAME=apptemplate   # database name (created automatically)
MONGO_IMAGE_TAG=7           # MongoDB Docker image tag
# Optional auth (leave blank for dev convenience):
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# ── Docker build target ───────────────────────────────────────────────────────
# dev  → runs with nodemon / vite dev server (hot-reload)
# prod → runs compiled build (faster, smaller image)
DOCKER_TARGET=dev
NODE_ENV=development

# ── Public app URL ────────────────────────────────────────────────────────────
# Must match what OAuth providers list as the allowed callback origin.
APP_URL=http://localhost:5173

# ── Vite / browser-side variables ────────────────────────────────────────────
# VITE_ prefix = safe to expose to browser. Never put secrets here.
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_NAME=AppTemplate
VITE_GOOGLE_CLIENT_ID=      # public OAuth client ID — matches server GOOGLE_CLIENT_ID

# ── SECOND STACK EXAMPLE ─────────────────────────────────────────────────────
# To run a second stack simultaneously (e.g. a feature branch):
# Create .env.feature and set:
#   COMPOSE_PROJECT_NAME=apptemplate-feature
#   FRONTEND_PORT=5174
#   BACKEND_PORT=3001
#   MONGO_PORT=27018
# Then: docker-compose --env-file .env.feature up
