import { useState, useEffect } from 'react'
import { useAuth } from '@/hooks/useAuth'
import { get{{Entities}}, create{{EntityName}}, update{{EntityName}}Stage, delete{{EntityName}} } from '../services/{{entities}}'
import type { I{{EntityName}}, PipelineStage } from '../types'
import { Button } from '@/components/ui/Button'
import { Modal } from '@/components/ui/Modal'
import { Input } from '@/components/ui/Input'
import { ConfirmDialog } from '@/components/ui/ConfirmDialog'
import { Skeleton } from '@/components/ui/Skeleton'
import { EmptyState } from '@/components/ui/EmptyState'
import { Plus, Trash2, DollarSign, Building2 } from 'lucide-react'

const STAGES: { key: PipelineStage; label: string; color: string }[] = [
  { key: 'prospect',    label: 'Prospect',    color: 'bg-gray-100 border-gray-300' },
  { key: 'qualified',   label: 'Qualified',   color: 'bg-blue-50 border-blue-300' },
  { key: 'proposal',    label: 'Proposal',    color: 'bg-yellow-50 border-yellow-300' },
  { key: 'negotiation', label: 'Negotiation', color: 'bg-orange-50 border-orange-300' },
  { key: 'won',         label: 'Won',         color: 'bg-green-50 border-green-300' },
  { key: 'lost',        label: 'Lost',        color: 'bg-red-50 border-red-300' },
]

const DEFAULT_FORM = {
  title: '',
  company: '',
  contactEmail: '',
  value: '',
  probability: '20',
  description: '',
}

export default function {{Entities}}Page() {
  const { token } = useAuth()
  const [items, setItems] = useState<I{{EntityName}}[]>([])
  const [loading, setLoading] = useState(true)
  const [open, setOpen] = useState(false)
  const [form, setForm] = useState(DEFAULT_FORM)
  const [saving, setSaving] = useState(false)
  const [deleteId, setDeleteId] = useState<string | null>(null)
  const [dragId, setDragId] = useState<string | null>(null)

  useEffect(() => {
    if (!token) return
    get{{Entities}}(token)
      .then(setItems)
      .catch(console.error)
      .finally(() => setLoading(false))
  }, [token])

  const byStage = (stage: PipelineStage) => items.filter(i => i.stage === stage)

  const totalValue = (stage: PipelineStage) =>
    byStage(stage).reduce((s, i) => s + (i.value ?? 0), 0)

  async function handleCreate(e: React.FormEvent) {
    e.preventDefault()
    if (!token || !form.title.trim()) return
    setSaving(true)
    try {
      const created = await create{{EntityName}}(
        {
          title: form.title.trim(),
          company: form.company.trim(),
          contactEmail: form.contactEmail.trim(),
          value: Number(form.value) || 0,
          probability: Number(form.probability) || 20,
          description: form.description.trim(),
        },
        token
      )
      setItems(prev => [created, ...prev])
      setOpen(false)
      setForm(DEFAULT_FORM)
    } catch (err) {
      console.error(err)
    } finally {
      setSaving(false)
    }
  }

  async function handleDrop(stage: PipelineStage) {
    if (!dragId || !token) return
    const item = items.find(i => i._id === dragId)
    if (!item || item.stage === stage) return
    setItems(prev => prev.map(i => i._id === dragId ? { ...i, stage } : i))
    try {
      await update{{EntityName}}Stage(dragId, stage, token)
    } catch {
      // revert on failure
      setItems(prev => prev.map(i => i._id === dragId ? { ...i, stage: item.stage } : i))
    }
    setDragId(null)
  }

  async function handleDelete(id: string) {
    if (!token) return
    setItems(prev => prev.filter(i => i._id !== id))
    try {
      await delete{{EntityName}}(id, token)
    } catch {
      console.error('Delete failed')
    }
    setDeleteId(null)
  }

  if (loading) {
    return (
      <div className="p-6">
        <Skeleton className="h-8 w-48 mb-6" />
        <div className="flex gap-4 overflow-x-auto">
          {STAGES.map(s => (
            <div key={s.key} className="w-64 shrink-0 space-y-3">
              <Skeleton className="h-6 w-32" />
              <Skeleton className="h-24 w-full" />
              <Skeleton className="h-24 w-full" />
            </div>
          ))}
        </div>
      </div>
    )
  }

  return (
    <div className="p-6 min-h-screen">
      {/* Header */}
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">{{Entities}} Pipeline</h1>
          <p className="text-sm text-gray-500 mt-0.5">{items.length} total · drag cards to update stage</p>
        </div>
        <Button onClick={() => setOpen(true)}>
          <Plus className="w-4 h-4 mr-1" /> Add {{EntityName}}
        </Button>
      </div>

      {/* Board */}
      {items.length === 0 ? (
        <EmptyState
          title="No {{entities}} yet"
          description="Add your first {{entityName}} to start tracking your pipeline."
          action={<Button onClick={() => setOpen(true)}><Plus className="w-4 h-4 mr-1" />Add {{EntityName}}</Button>}
        />
      ) : (
        <div className="flex gap-4 overflow-x-auto pb-4">
          {STAGES.map(stage => (
            <div
              key={stage.key}
              className="w-72 shrink-0 flex flex-col"
              onDragOver={e => e.preventDefault()}
              onDrop={() => handleDrop(stage.key)}
            >
              {/* Column header */}
              <div className={`rounded-t-lg border-b-2 px-3 py-2 ${stage.color}`}>
                <div className="flex items-center justify-between">
                  <span className="font-semibold text-sm text-gray-700">{stage.label}</span>
                  <span className="text-xs text-gray-500 font-medium">{byStage(stage.key).length}</span>
                </div>
                {totalValue(stage.key) > 0 && (
                  <p className="text-xs text-gray-500 mt-0.5">
                    ${totalValue(stage.key).toLocaleString()}
                  </p>
                )}
              </div>

              {/* Cards */}
              <div className={`flex-1 rounded-b-lg border border-t-0 p-2 space-y-2 min-h-[200px] ${stage.color}`}>
                {byStage(stage.key).map(item => (
                  <div
                    key={item._id}
                    draggable
                    onDragStart={() => setDragId(item._id)}
                    onDragEnd={() => setDragId(null)}
                    className="bg-white rounded-lg shadow-sm border border-gray-200 p-3 cursor-grab active:cursor-grabbing group"
                  >
                    <div className="flex items-start justify-between gap-2">
                      <p className="font-medium text-sm text-gray-900 leading-tight">{item.title}</p>
                      <button
                        onClick={() => setDeleteId(item._id)}
                        className="opacity-0 group-hover:opacity-100 text-gray-400 hover:text-red-500 transition-opacity shrink-0"
                      >
                        <Trash2 className="w-3.5 h-3.5" />
                      </button>
                    </div>

                    {item.company && (
                      <div className="flex items-center gap-1 mt-1.5 text-xs text-gray-500">
                        <Building2 className="w-3 h-3" />
                        {item.company}
                      </div>
                    )}

                    {(item.value ?? 0) > 0 && (
                      <div className="flex items-center gap-1 mt-1 text-xs font-medium text-green-600">
                        <DollarSign className="w-3 h-3" />
                        {item.value.toLocaleString()}
                        {item.probability > 0 && (
                          <span className="text-gray-400 font-normal ml-1">· {item.probability}%</span>
                        )}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Create modal */}
      <Modal open={open} onClose={() => setOpen(false)} title="Add {{EntityName}}">
        <form onSubmit={handleCreate} className="space-y-4">
          <Input
            label="Title *"
            value={form.title}
            onChange={e => setForm(p => ({ ...p, title: e.target.value }))}
            placeholder="e.g. Acme Corp deal"
            required
          />
          <div className="grid grid-cols-2 gap-3">
            <Input
              label="Company"
              value={form.company}
              onChange={e => setForm(p => ({ ...p, company: e.target.value }))}
              placeholder="Company name"
            />
            <Input
              label="Contact email"
              type="email"
              value={form.contactEmail}
              onChange={e => setForm(p => ({ ...p, contactEmail: e.target.value }))}
              placeholder="contact@example.com"
            />
          </div>
          <div className="grid grid-cols-2 gap-3">
            <Input
              label="Value ($)"
              type="number"
              min="0"
              value={form.value}
              onChange={e => setForm(p => ({ ...p, value: e.target.value }))}
              placeholder="0"
            />
            <Input
              label="Probability (%)"
              type="number"
              min="0"
              max="100"
              value={form.probability}
              onChange={e => setForm(p => ({ ...p, probability: e.target.value }))}
            />
          </div>
          <Input
            label="Description"
            value={form.description}
            onChange={e => setForm(p => ({ ...p, description: e.target.value }))}
            placeholder="Optional notes..."
          />
          <div className="flex justify-end gap-2 pt-2">
            <Button type="button" variant="ghost" onClick={() => setOpen(false)}>Cancel</Button>
            <Button type="submit" loading={saving} disabled={!form.title.trim()}>
              Add {{EntityName}}
            </Button>
          </div>
        </form>
      </Modal>

      {/* Delete confirm */}
      <ConfirmDialog
        open={!!deleteId}
        title="Delete {{EntityName}}"
        description="This action cannot be undone."
        onConfirm={() => deleteId && handleDelete(deleteId)}
        onCancel={() => setDeleteId(null)}
      />
    </div>
  )
}
