# ═════════════════════════════════════════════════════════════════════════════
# BACKEND ENVIRONMENT VARIABLES
# Copy to server/.env — never commit server/.env
#
# These are loaded by dotenv in development and passed as env vars in Docker.
# In docker-compose, MONGODB_URI and PORT are overridden at the compose level
# so the server always connects to the local mongo container during development.
# ═════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
# The port Express binds to inside the container.
# Overridden by docker-compose to match BACKEND_INTERNAL_PORT.
PORT=3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# docker-compose overrides this with the local mongo container URI.
# Set this to your Atlas connection string for production.
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://localhost:27017/apptemplate

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
# Minimum 16 characters — longer is better.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_EXPIRES_IN=7d

# ── OAuth — Google ────────────────────────────────────────────────────────────
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorised redirect URIs (add both for dev + prod):
#   http://localhost:3000/api/auth/google/callback
#   https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — GitHub ────────────────────────────────────────────────────────────
# Create OAuth app: https://github.com/settings/developers
# Callback URLs:
#   http://localhost:3000/api/auth/github/callback
#   https://yourdomain.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email provider ────────────────────────────────────────────────────────────
# Set EMAIL_PROVIDER to: resend | sendgrid | mailgun
# Only the matching key needs to be filled in.
# Emails are fire-and-forget — registration never fails due to email errors.
EMAIL_PROVIDER=resend

# Resend — https://resend.com (free: 3 000 emails/month)
RESEND_API_KEY=

# SendGrid — https://sendgrid.com (free: 100 emails/day)
SENDGRID_API_KEY=

# Mailgun — https://mailgun.com (free: 5 000 emails/3 months)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── App ───────────────────────────────────────────────────────────────────────
# From address used in outgoing emails
FROM_EMAIL=hello@example.com

# Frontend public URL — used for:
#   1. CORS allowed origin
#   2. OAuth callback redirect back to frontend
#   3. Links inside emails
# Overridden by docker-compose to match APP_URL from root .env.
APP_URL=http://localhost:5173
