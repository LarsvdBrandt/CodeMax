import { useState, useEffect } from 'react'
import { KanbanBoard } from '@/components/ui/KanbanBoard'
import type { KanbanColumn, KanbanCard } from '@/components/ui/KanbanBoard'
import { Modal } from '@/components/ui/Modal'
import { Button } from '@/components/ui/Button'
import { Input } from '@/components/ui/Input'
import { Select } from '@/components/ui/Select'
import { Spinner } from '@/components/ui/Spinner'
import { useToast } from '@/components/ui/Toast'
import { useAuth } from '@/hooks/useAuth'
import {
  get{{Entities}},
  create{{EntityName}},
  update{{EntityName}},
  update{{EntityName}}Status,
  delete{{EntityName}},
} from '../services/{{entities}}'
import type { I{{EntityName}}, Create{{EntityName}}Request, {{EntityName}}Status } from '../types'

const COLUMNS: { id: {{EntityName}}Status; label: string; color: string }[] = [
  { id: 'todo',        label: 'To Do',       color: 'var(--color-muted, #888)' },
  { id: 'in-progress', label: 'In Progress', color: 'var(--color-accent, #6366F1)' },
  { id: 'done',        label: 'Done',        color: '#22c55e' },
]

function itemsToColumns(items: I{{EntityName}}[]): KanbanColumn[] {
  return COLUMNS.map(col => ({
    id: col.id,
    label: col.label,
    color: col.color,
    cards: items
      .filter(i => i.status === col.id)
      .map(i => ({
        id: i._id,
        title: i.title,
        description: i.description,
        priority: (i.priority ?? 'medium') as KanbanCard['priority'],
        columnId: col.id,
      })),
  }))
}

export default function {{Entities}}Page() {
  const { token } = useAuth()
  const { toast } = useToast()
  const [items, setItems] = useState<I{{EntityName}}[]>([])
  const [loading, setLoading] = useState(true)
  const [columns, setColumns] = useState<KanbanColumn[]>(COLUMNS.map(c => ({ ...c, cards: [] })))

  const [modalOpen, setModalOpen] = useState(false)
  const [editing, setEditing] = useState<I{{EntityName}} | null>(null)
  const [form, setForm] = useState<Create{{EntityName}}Request>({ title: '', description: '' })
  const [saving, setSaving] = useState(false)
  const [newCardColumn, setNewCardColumn] = useState<{{EntityName}}Status>('todo')

  useEffect(() => {
    if (!token) return
    setLoading(true)
    get{{Entities}}(token)
      .then(data => {
        setItems(data)
        setColumns(itemsToColumns(data))
      })
      .catch(() => toast.error('Failed to load {{entities}}'))
      .finally(() => setLoading(false))
  }, [token])

  function handleColumnsChange(next: KanbanColumn[]) {
    setColumns(next)
    next.forEach(col => {
      col.cards.forEach(card => {
        const item = items.find(i => i._id === card.id)
        if (item && item.status !== col.id) {
          update{{EntityName}}Status(card.id, col.id as {{EntityName}}Status, token!)
            .then(updated => setItems(prev => prev.map(i => i._id === updated._id ? updated : i)))
            .catch(() => {
              setColumns(itemsToColumns(items))
              toast.error('Failed to update status')
            })
        }
      })
    })
  }

  function openCreate(columnId?: string) {
    setEditing(null)
    const status = (columnId as {{EntityName}}Status) ?? 'todo'
    setForm({ title: '', description: '', status })
    setNewCardColumn(status)
    setModalOpen(true)
  }

  function openEdit(card: KanbanCard) {
    const item = items.find(i => i._id === card.id)
    if (!item) return
    setEditing(item)
    setForm({ title: item.title, description: item.description, status: item.status, priority: item.priority })
    setModalOpen(true)
  }

  async function handleSave() {
    if (!form.title.trim() || !token) return
    setSaving(true)
    try {
      if (editing) {
        const updated = await update{{EntityName}}(editing._id, form, token)
        const next = items.map(i => i._id === updated._id ? updated : i)
        setItems(next)
        setColumns(itemsToColumns(next))
        toast.success('{{EntityName}} updated')
      } else {
        const created = await create{{EntityName}}({ ...form, status: newCardColumn }, token)
        const next = [...items, created]
        setItems(next)
        setColumns(itemsToColumns(next))
        toast.success('{{EntityName}} created')
      }
      setModalOpen(false)
    } catch {
      toast.error('Failed to save')
    } finally {
      setSaving(false)
    }
  }

  async function handleDelete() {
    if (!editing || !token) return
    setSaving(true)
    try {
      await delete{{EntityName}}(editing._id, token)
      const next = items.filter(i => i._id !== editing._id)
      setItems(next)
      setColumns(itemsToColumns(next))
      toast.success('{{EntityName}} deleted')
      setModalOpen(false)
    } catch {
      toast.error('Failed to delete')
    } finally {
      setSaving(false)
    }
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[60vh]">
        <Spinner size="lg" />
      </div>
    )
  }

  return (
    <div className="p-6 max-w-screen-xl mx-auto">
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold text-foreground">{{Entities}}</h1>
          <p className="text-sm text-muted mt-0.5">{items.length} item{items.length !== 1 ? 's' : ''}</p>
        </div>
        <Button onClick={() => openCreate()} size="sm">+ New {{EntityName}}</Button>
      </div>

      <KanbanBoard
        columns={columns}
        onChange={handleColumnsChange}
        onCardClick={openEdit}
        onCreateCard={columnId => openCreate(columnId)}
      />

      <Modal
        isOpen={modalOpen}
        onClose={() => setModalOpen(false)}
        title={editing ? 'Edit {{EntityName}}' : 'New {{EntityName}}'}
      >
        <div className="space-y-4">
          <Input
            label="Title"
            value={form.title}
            onChange={e => setForm(f => ({ ...f, title: e.target.value }))}
            placeholder="Enter title..."
          />
          <Input
            label="Description"
            value={form.description ?? ''}
            onChange={e => setForm(f => ({ ...f, description: e.target.value }))}
            placeholder="Optional description..."
          />
          <Select
            label="Priority"
            value={form.priority ?? 'medium'}
            onChange={e => setForm(f => ({ ...f, priority: e.target.value as I{{EntityName}}['priority'] }))}
            options={[
              { value: 'low',    label: 'Low' },
              { value: 'medium', label: 'Medium' },
              { value: 'high',   label: 'High' },
            ]}
          />
          {editing && (
            <Select
              label="Status"
              value={form.status ?? 'todo'}
              onChange={e => setForm(f => ({ ...f, status: e.target.value as {{EntityName}}Status }))}
              options={COLUMNS.map(c => ({ value: c.id, label: c.label }))}
            />
          )}
        </div>
        <div className="flex justify-between mt-6">
          {editing ? (
            <Button variant="danger" onClick={handleDelete} disabled={saving}>Delete</Button>
          ) : <div />}
          <div className="flex gap-2">
            <Button variant="ghost" onClick={() => setModalOpen(false)} disabled={saving}>Cancel</Button>
            <Button onClick={handleSave} disabled={saving || !form.title.trim()}>
              {saving ? 'Saving…' : editing ? 'Save changes' : 'Create'}
            </Button>
          </div>
        </div>
      </Modal>
    </div>
  )
}
