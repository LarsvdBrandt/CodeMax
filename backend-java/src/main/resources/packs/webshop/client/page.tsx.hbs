import { useState, useEffect, useMemo } from 'react'
import { Modal } from '@/components/ui/Modal'
import { Button } from '@/components/ui/Button'
import { Input } from '@/components/ui/Input'
import { ConfirmDialog } from '@/components/ui/ConfirmDialog'
import { EmptyState } from '@/components/ui/EmptyState'
import { Spinner } from '@/components/ui/Spinner'
import { useToast } from '@/components/ui/Toast'
import { useAuth } from '@/hooks/useAuth'
import { ShoppingBag } from 'lucide-react'
import { get{{Entities}}, create{{EntityName}}, update{{EntityName}}, delete{{EntityName}} } from '../services/{{entities}}'
import type { I{{EntityName}}, Create{{EntityName}}Request } from '../types'

const EMPTY_FORM: Create{{EntityName}}Request = {
  title: '',
  description: '',
  imageUrl: '',
  price: 0,
  category: '',
  stock: 0,{{extraFormState}}
}

export default function {{Entities}}Page() {
  const { token } = useAuth()
  const { toast } = useToast()
  const [items, setItems] = useState<I{{EntityName}}[]>([])
  const [loading, setLoading] = useState(true)
  const [search, setSearch] = useState('')
  const [activeCategory, setActiveCategory] = useState('all')

  const [modalOpen, setModalOpen] = useState(false)
  const [editing, setEditing] = useState<I{{EntityName}} | null>(null)
  const [form, setForm] = useState<Create{{EntityName}}Request>(EMPTY_FORM)
  const [saving, setSaving] = useState(false)
  const [deleteTarget, setDeleteTarget] = useState<I{{EntityName}} | null>(null)

  useEffect(() => {
    if (!token) return
    setLoading(true)
    get{{Entities}}(token)
      .then(setItems)
      .catch(() => toast.error('Failed to load {{entities}}'))
      .finally(() => setLoading(false))
  }, [token])

  const categories = useMemo(() => {
    const cats = Array.from(new Set(items.map(i => i.category).filter(Boolean)))
    return ['all', ...cats]
  }, [items])

  const filtered = useMemo(() => {
    return items.filter(item => {
      const matchSearch = !search || item.title.toLowerCase().includes(search.toLowerCase())
      const matchCat = activeCategory === 'all' || item.category === activeCategory
      return matchSearch && matchCat
    })
  }, [items, search, activeCategory])

  function openCreate() {
    setEditing(null)
    setForm(EMPTY_FORM)
    setModalOpen(true)
  }

  function openEdit(item: I{{EntityName}}) {
    setEditing(item)
    setForm({
      title: item.title,
      description: item.description ?? '',
      imageUrl: item.imageUrl ?? '',
      price: item.price ?? 0,
      category: item.category ?? '',
      stock: item.stock ?? 0,{{extraFormState}}
    })
    setModalOpen(true)
  }

  async function handleSave() {
    if (!form.title.trim() || !token) return
    setSaving(true)
    try {
      if (editing) {
        const updated = await update{{EntityName}}(editing._id, form, token)
        setItems(prev => prev.map(i => i._id === updated._id ? updated : i))
        toast.success('{{EntityName}} updated')
      } else {
        const created = await create{{EntityName}}(form, token)
        setItems(prev => [created, ...prev])
        toast.success('{{EntityName}} added')
      }
      setModalOpen(false)
    } catch {
      toast.error('Failed to save')
    } finally {
      setSaving(false)
    }
  }

  async function handleDelete() {
    if (!deleteTarget || !token) return
    try {
      await delete{{EntityName}}(deleteTarget._id, token)
      setItems(prev => prev.filter(i => i._id !== deleteTarget._id))
      toast.success('{{EntityName}} deleted')
    } catch {
      toast.error('Failed to delete')
    } finally {
      setDeleteTarget(null)
    }
  }

  if (loading) {
    return (
      <div className="flex items-center justify-center min-h-[60vh]">
        <Spinner size="lg" />
      </div>
    )
  }

  return (
    <div className="p-6 max-w-screen-xl mx-auto">
      {/* Header */}
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold text-foreground">{{Entities}}</h1>
          <p className="text-sm text-muted mt-0.5">{items.length} item{items.length !== 1 ? 's' : ''}</p>
        </div>
        <Button onClick={openCreate} size="sm">+ Add {{EntityName}}</Button>
      </div>

      {/* Search + category filter */}
      <div className="flex flex-wrap items-center gap-3 mb-6">
        <input
          type="text"
          value={search}
          onChange={e => setSearch(e.target.value)}
          placeholder="Search {{entities}}…"
          className="flex-1 min-w-[180px] max-w-xs bg-card border border-border rounded-lg px-3 py-2 text-sm text-foreground placeholder-muted focus:outline-none focus:border-accent transition-colors"
        />
        <div className="flex flex-wrap gap-2">
          {categories.map(cat => (
            <button
              key={cat}
              onClick={() => setActiveCategory(cat)}
              className={`px-3 py-1.5 rounded-full text-xs font-medium capitalize transition-all ${
                activeCategory === cat
                  ? 'bg-accent text-white'
                  : 'bg-card border border-border text-muted hover:text-foreground hover:border-accent/50'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      {/* Product grid */}
      {filtered.length === 0 ? (
        <EmptyState
          icon={<ShoppingBag className="h-8 w-8" />}
          title={items.length === 0 ? 'No {{entities}} yet' : 'No results'}
          description={items.length === 0 ? 'Add your first {{entityName}} to get started.' : 'Try a different search or category.'}
          action={items.length === 0 ? { label: '+ Add {{EntityName}}', onClick: openCreate } : undefined}
        />
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {filtered.map(item => (
            <div key={item._id} className="group relative bg-card border border-border rounded-xl overflow-hidden hover:border-accent/40 transition-all">
              {/* Product image */}
              <div className="aspect-square bg-muted/10 overflow-hidden">
                {item.imageUrl ? (
                  <img
                    src={item.imageUrl}
                    alt={item.title}
                    className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    onError={e => { (e.target as HTMLImageElement).style.display = 'none' }}
                  />
                ) : (
                  <div className="w-full h-full flex items-center justify-center text-muted">
                    <ShoppingBag className="w-12 h-12 opacity-20" />
                  </div>
                )}
              </div>

              {/* Card body */}
              <div className="p-3">
                {item.category && (
                  <span className="inline-block text-[10px] font-semibold uppercase tracking-wider text-accent/80 mb-1">
                    {item.category}
                  </span>
                )}
                <h3 className="text-sm font-semibold text-foreground truncate">{item.title}</h3>
                {item.description && (
                  <p className="text-xs text-muted mt-0.5 line-clamp-2">{item.description}</p>
                )}
                <div className="flex items-center justify-between mt-2">
                  <span className="text-sm font-bold text-foreground">
                    {new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(item.price ?? 0)}
                  </span>
                  {item.stock !== undefined && (
                    <span className={`text-[10px] font-medium px-1.5 py-0.5 rounded ${
                      item.stock > 0 ? 'bg-green-500/10 text-green-400' : 'bg-red-500/10 text-red-400'
                    }`}>
                      {item.stock > 0 ? `${item.stock} in stock` : 'Out of stock'}
                    </span>
                  )}
                </div>
              </div>

              {/* Hover overlay actions */}
              <div className="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                <Button size="sm" onClick={() => openEdit(item)}>Edit</Button>
                <Button size="sm" variant="danger" onClick={() => setDeleteTarget(item)}>Delete</Button>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Create / Edit modal */}
      <Modal
        isOpen={modalOpen}
        onClose={() => setModalOpen(false)}
        title={editing ? 'Edit {{EntityName}}' : 'Add {{EntityName}}'}
      >
        <div className="space-y-4">
          <Input
            label="Title"
            value={form.title}
            onChange={e => setForm(f => ({ ...f, title: e.target.value }))}
            placeholder="Product name…"
          />
          <Input
            label="Description"
            value={form.description ?? ''}
            onChange={e => setForm(f => ({ ...f, description: e.target.value }))}
            placeholder="Short description…"
          />
          <Input
            label="Image URL"
            value={form.imageUrl ?? ''}
            onChange={e => setForm(f => ({ ...f, imageUrl: e.target.value }))}
            placeholder="https://example.com/image.jpg"
          />
          <div className="grid grid-cols-2 gap-3">
            <Input
              label="Price"
              type="number"
              value={String(form.price ?? 0)}
              onChange={e => setForm(f => ({ ...f, price: parseFloat(e.target.value) || 0 }))}
              placeholder="0.00"
            />
            <Input
              label="Stock"
              type="number"
              value={String(form.stock ?? 0)}
              onChange={e => setForm(f => ({ ...f, stock: parseInt(e.target.value) || 0 }))}
              placeholder="0"
            />
          </div>
          <Input
            label="Category"
            value={form.category ?? ''}
            onChange={e => setForm(f => ({ ...f, category: e.target.value }))}
            placeholder="e.g. Electronics, Clothing…"
          />
{{extraFormFields}}
        </div>
        <div className="flex justify-end gap-2 mt-6">
          <Button variant="ghost" onClick={() => setModalOpen(false)} disabled={saving}>Cancel</Button>
          <Button onClick={handleSave} disabled={saving || !form.title.trim()}>
            {saving ? 'Saving…' : editing ? 'Save changes' : 'Add {{EntityName}}'}
          </Button>
        </div>
      </Modal>

      {deleteTarget && (
        <ConfirmDialog
          isOpen
          title="Delete {{EntityName}}"
          description={`Delete "${deleteTarget.title}"? This cannot be undone.`}
          confirmLabel="Delete"
          variant="danger"
          onConfirm={handleDelete}
          onCancel={() => setDeleteTarget(null)}
        />
      )}
    </div>
  )
}
