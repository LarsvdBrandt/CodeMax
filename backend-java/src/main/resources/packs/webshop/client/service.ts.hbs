import type { I{{EntityName}}, Create{{EntityName}}Request, Update{{EntityName}}Request } from '../types'

const BASE = (import.meta.env.VITE_API_URL ?? '') + '/api/{{entities}}'

export async function get{{Entities}}(token: string, category?: string): Promise<I{{EntityName}}[]> {
  const url = category && category !== 'all' ? `${BASE}?category=${encodeURIComponent(category)}` : BASE
  const res = await fetch(url, {
    headers: { Authorization: `Bearer ${token}` },
  })
  if (!res.ok) throw new Error(await res.text())
  return res.json()
}

export async function create{{EntityName}}(data: Create{{EntityName}}Request, token: string): Promise<I{{EntityName}}> {
  const res = await fetch(BASE, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
    body: JSON.stringify(data),
  })
  if (!res.ok) throw new Error(await res.text())
  return res.json()
}

export async function update{{EntityName}}(id: string, data: Update{{EntityName}}Request, token: string): Promise<I{{EntityName}}> {
  const res = await fetch(`${BASE}/${id}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
    body: JSON.stringify(data),
  })
  if (!res.ok) throw new Error(await res.text())
  return res.json()
}

export async function delete{{EntityName}}(id: string, token: string): Promise<void> {
  const res = await fetch(`${BASE}/${id}`, {
    method: 'DELETE',
    headers: { Authorization: `Bearer ${token}` },
  })
  if (!res.ok) throw new Error(await res.text())
}
